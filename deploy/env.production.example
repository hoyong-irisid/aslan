# Copy to ~/apps/aslan/.env on the VPS (never commit real keys).

ASLAN_API_HOST=127.0.0.1
ASLAN_API_PORT=8010

# Qdrant Cloud (recommended) or local Docker on same VPS
QDRANT_URL=https://YOUR-CLUSTER.cloud.qdrant.io:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=iris_docs
QDRANT_COLLECTION_PARTNER=iris_partner

PARTNER_CODES=1234
PARTNER_SESSION_TTL_MINUTES=120
# Pin partner SQLite to one file (recommended on VPS):
# PARTNER_DB_PATH=/home/USER/apps/aslan/data/partners.db
# PARTNER_ADMIN_API_KEY=
# PARTNER_DOCS_DIR=/home/USER/aslan-rag/partner_docs

LLM_PROVIDER=gemini
GOOGLE_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
ASLAN_GEMINI_AGENT=true

WEB_SEARCH_PROVIDER=google_cse
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=

RESEND_API_KEY=
RESEND_FROM=Iris ID <noreply@irisid.com>
