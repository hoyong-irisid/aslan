# API
ASLAN_API_HOST=0.0.0.0
ASLAN_API_PORT=8000

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=iris_docs

# Embeddings (set one provider)
# Google Gemini
GOOGLE_API_KEY=

# OpenAI-compatible (optional alternative)
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# Generation: gemini | openai
LLM_PROVIDER=gemini
GEMINI_CHAT_MODEL=gemini-2.0-flash
