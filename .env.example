# API
ASLAN_API_HOST=0.0.0.0
ASLAN_API_PORT=8000

# Qdrant
# Local: http://localhost:6333 (leave QDRANT_API_KEY empty)
# Cloud: https://xxxx.cloud.qdrant.io (cluster URL from Qdrant Cloud; include :6333 if your console shows it)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=iris_docs
# Separate collection for partner-only KB (e.g. iA1000 manual, history).
QDRANT_COLLECTION_PARTNER=iris_partner

# Partner access: legacy static codes (comma-separated) plus SQLite registry (signup/admin).
PARTNER_CODES=1234
PARTNER_SESSION_TTL_MINUTES=120
# SQLite DB for registered partners (created automatically).
# PARTNER_DB_PATH=data/partners.db
# Admin portal API key (header X-Partner-Admin-Key). Required for /partner/admin.html
# PARTNER_ADMIN_API_KEY=change-me-to-a-long-random-secret
# PARTNER_OTP_TTL_MINUTES=10
# Folder with partner PDFs/text (outside git). Default: ../aslan-rag/partner_docs next to this repo.
# PARTNER_DOCS_DIR=/absolute/path/to/partner_docs

# Embeddings (set one provider)
# Google Gemini
GOOGLE_API_KEY=
# Embeddings when using Google only (text-embedding-004 is often 404 for new keys)
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# OpenAI-compatible (optional alternative)
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# Generation: gemini | openai
LLM_PROVIDER=gemini
# Gemini: FAQ 다음에 function calling 에이전트(지식 검색 툴 + 일반 답). 예전 라우터만 쓰려면 false.
ASLAN_GEMINI_AGENT=true

# Web search (에이전트 web_search 툴)
# WEB_SEARCH_PROVIDER=auto   → Google CSE 키가 있으면 구글 우선, 없으면 Tavily → Serper
# WEB_SEARCH_PROVIDER=google_cse   → 구글만 (권장: 검색 품질이 구글과 동일 인덱스)
# WEB_SEARCH_PROVIDER=tavily | serper | none
#
# --- Google Programmable Search (Custom Search JSON API) 설정 요약 ---
# 1) Google Cloud Console에서 프로젝트 생성 → "Custom Search API" 사용 설정
# 2) "사용자 인증 정보"에서 API 키 만들기 → GOOGLE_CSE_API_KEY
# 3) https://programmablesearchengine.google.com/ 에서 검색엔진 생성 → 검색 ID(cx) 복사 → GOOGLE_CSE_ID
#    (전체 웹 검색: 엔진 설정에서 "전체 웹 검색" 허용)
WEB_SEARCH_PROVIDER=google_cse
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=
# TAVILY_API_KEY=
# SERPER_API_KEY=
# WEB_SEARCH_MAX_RESULTS=5
# Model id must match AI Studio → Models (ListModels).
# New API keys: gemini-2.0-flash often returns 404 ("no longer available to new users") — use 2.5+ or ListModels.
GEMINI_CHAT_MODEL=gemini-2.5-flash
# Other examples from your project’s model list: gemini-2.5-pro, gemini-1.5-flash-002, preview model ids, …

# Optional: email chat transcripts (partner session). Requires verified partner_token.
#
# Resend (recommended for local dev — HTTPS API, no SMTP):
# RESEND_API_KEY=re_xxxx
# RESEND_FROM=Iris ID <noreply@irisid.com>
#
# Or classic SMTP:
# SMTP_USE_SSL=true for port 465; otherwise STARTTLS on port 587.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false
